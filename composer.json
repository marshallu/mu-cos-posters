{
	"name": "marshallu/mu-cos-posters",
	"description": "Plugin for displaying College of Science poster printing information.",
	"keywords": ["wordpress", "plugin"],
	"homepage": "https://github.com/marshallu/mu-cos-posters",
	"license": "MIT",
	"type": "wordpress-plugin",
	"require": {
		"php": ">=8.3"
	},
	"require-dev": {
		"dealerdirect/phpcodesniffer-composer-installer": "^0.7.1",
		"php-stubs/acf-pro-stubs": "^6.0",
		"phpstan/phpstan": "^2.1",
		"szepeviktor/phpstan-wordpress": "^2.0",
		"php-stubs/wordpress-stubs": "^6.9",
		"php-stubs/wp-cli-stubs": "^2.12",
		"squizlabs/php_codesniffer": "@stable",
		"wp-coding-standards/wpcs": "^3.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"scripts": {
		"format": "phpcbf --extensions=php --standard=phpcs.xml",
		"lint": "phpcs --extensions=php --standard=phpcs.xml",
		"analyse": "phpstan analyse --memory-limit=4G"
	}
}
